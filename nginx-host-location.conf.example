# Add these locations inside the existing server {} serving your website.
# Keep proxy_pass's trailing slash so /qingxu/app.js becomes /app.js.
# The container's default HOST_PORT must remain 18080 for this example.
location = /qingxu {
    return 301 /qingxu/;
}

location /qingxu/ {
    proxy_pass http://127.0.0.1:18080/;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
}
